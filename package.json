{
  "name": "analog-signal-processing-practice",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint:imports": "biome check --only=organizeImports .",
    "format:imports": "biome check --write --only=organizeImports .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:screenshots": "playwright test tests/e2e/visual-screenshots.spec.ts",
    "test:e2e:solvers": "playwright test tests/e2e/solver-visual-snapshots.spec.ts",
    "capture:solvers": "playwright test tests/e2e/solver-visual-snapshots.spec.ts && node scripts/generate-solver-gallery.ts",
    "capture:screenshots": "node scripts/capture-readme-screenshots.ts",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.100.2",
    "idb": "^8.0.3",
    "katex": "^0.18.2"
  }
}
