{
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		},
		{
			"files": [
				"*.json",
				"*.json5",
				"*.jsonc",
				"*.svg",
				"*.yaml",
				"*.yml"
			],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	],
	"printWidth": 80,
	"tabWidth": 4,
	"useTabs": true,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "all",
	"objectWrap": "preserve",
	"svelteSortOrder": "scripts-options-markup-styles",
	"singleAttributePerLine": true,
	"svelteIndentScriptAndStyle": true,
	"htmlWhitespaceSensitivity": "css",
	"bracketSpacing": true,
	"bracketSameLine": false
}
