{
  "plugins": [
    "prettier-plugin-svelte"
  ],
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    }
  ],
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": true,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "objectWrap": "preserve",
  "svelteSortOrder": "scripts-options-markup-styles",
  "singleAttributePerLine": true,
  "svelteIndentScriptAndStyle": true,
  "htmlWhitespaceSensitivity": "css",
  "bracketSpacing": true,
  "bracketSameLine": false
}
